PROJECT_NAME="AgriGuardian AI Backend"
ENVIRONMENT="development"
DEBUG=true

# MongoDB Configuration
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="agriguardian_db"

# JWT Auth Configuration
JWT_SECRET_KEY="super-secret-jwt-key-agriguardian-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Security & CORS
ALLOWED_ORIGINS="*"
RATE_LIMIT_PER_MINUTE="60/minute"

# External API Configurations (Mocked default fallbacks provided)
WEATHER_API_KEY="mock-weather-key"
MARKET_API_KEY="mock-market-key"
